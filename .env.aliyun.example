# Copy this file to /opt/new-api/.env on ECS; keep real credentials out of GitHub.
NEW_API_IMAGE=crpi-0i06zfbhrbl4bf0a.cn-guangzhou.personal.cr.aliyuncs.com/logwing/new-api:latest
# Use the RDS PostgreSQL internal endpoint reachable from this ECS.
# Create the newapi database and user first. URL-encode special characters in passwords.
SQL_DSN='postgresql://newapi:REPLACE_WITH_DATABASE_PASSWORD@REPLACE_WITH_RDS_INTERNAL_HOST:5432/newapi?sslmode=require'
# Attach the independently managed Redis container to this external network,
# with the network alias new-api-redis. Redis must accept connections on that network.
REDIS_DOCKER_NETWORK=new-api-backend
REDIS_CONN_STRING='redis://default:REPLACE_WITH_REDIS_PASSWORD@new-api-redis:6379/0'
# Generate once with openssl rand -hex 32; retain this value across deployments.
SESSION_SECRET=REPLACE_WITH_A_PERSISTENT_RANDOM_SECRET
# Default: access through a reverse proxy on this ECS.
NEW_API_BIND_ADDRESS=127.0.0.1
NEW_API_PORT=3000
